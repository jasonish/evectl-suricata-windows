# Pinned versions for the Suricata Windows build.
#
# Bump SURICATA_VERSION (and its checksum) when a new 8.0.x release is
# published. Bump PACKAGE_RELEASE when re-packaging the same Suricata
# version (new patch, dependency refresh, packaging fix). Reset it to 1
# when SURICATA_VERSION changes.
#
# The release tag is ${SURICATA_VERSION}-${PACKAGE_RELEASE}, e.g. 8.0.7-1.

SURICATA_VERSION=8.0.7
SURICATA_SHA256=a9d46a9c8f40e81f8a6df3ecc2c5a9a8e8da985876299108d92da547c013ba8c
SURICATA_URL=https://www.openinfosecfoundation.org/download/suricata-${SURICATA_VERSION}.tar.gz

PACKAGE_RELEASE=1

# Npcap SDK: link-time only. The Npcap runtime (wpcap.dll, Packet.dll and
# the driver) is never included in the package; users install Npcap
# themselves.
NPCAP_SDK_VERSION=1.16
NPCAP_SDK_SHA256=f0a8be7778ee3ae1b99bbbecb27a3ff0f6c111a4093f1c78c5c5a099607184db
NPCAP_SDK_URL=https://npcap.com/dist/npcap-sdk-${NPCAP_SDK_VERSION}.zip

# Npcap runtime used ONLY to run the freshly built suricata.exe for smoke
# tests on machines without Npcap installed (CI). Extracted from the
# installer with 7z; never copied into the package. 1.00 is the last
# installer that 7z can unpack.
NPCAP_RUNTIME_VERSION=1.00
NPCAP_RUNTIME_SHA256=488ab12e28e81d0dcf3d5d996f9cb676293f6f73b39e9c99476b5a44cec2250a
NPCAP_RUNTIME_URL=https://npcap.com/dist/npcap-${NPCAP_RUNTIME_VERSION}.exe
